{
  "name": "baton-cli",
  "version": "1.3.0",
  "description": "Repo-native continuity and verification kit for AI-assisted development",
  "type": "module",
  "bin": {
    "baton": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx src/cli.ts",
    "test": "npm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "guard:network": "node scripts/guard-network.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "12.1.0",
    "picomatch": "4.0.7",
    "yaml": "2.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.0",
    "@types/picomatch": "^4.0.3",
    "tsup": "8.3.0",
    "tsx": "4.19.0",
    "typescript": "5.6.2",
    "vite": "5.4.0",
    "vitest": "2.1.0"
  }
}
